<Window x:Class="ImageGridSizeCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网格拼接图片尺寸计算器" Height="680" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI"
        Icon="logo.ico"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- 圆角矩形纯数字输入框样式 -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DCDFE6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#303133"/>
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            <EventSetter Event="PreviewTextInput" Handler="OnNumberPreviewTextInput"/>
            <EventSetter Event="PreviewKeyDown" Handler="OnNumberPreviewKeyDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#C0C4CC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#409EFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F7FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E4E7ED"/>
                                <Setter Property="Foreground" Value="#C0C4CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#606266"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Background="#FFFFFF" CornerRadius="12" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="网格拼接图片尺寸计算器" FontSize="20" FontWeight="Bold" Foreground="#303133" HorizontalAlignment="Center"/>
                        <TextBlock Text="配置网格矩阵、间距及外边框参数，快速计算成品图宽高" FontSize="12" Foreground="#909399" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 素材宽高 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="素材宽度 (px)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtSourceWidth" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="OnInputChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="素材高度 (px)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtSourceHeight" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="OnInputChanged"/>
                            </StackPanel>

                            <!-- 矩阵行列 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="矩阵列数 (Columns)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtMatrixColumns" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="OnInputChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="矩阵行数 (Rows)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtMatrixRows" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="OnInputChanged"/>
                            </StackPanel>

                            <!-- 水平与垂直间距 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="水平间距 (px)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtHorizontalSpacing" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="OnInputChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="垂直间距 (px)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtVerticalSpacing" Style="{StaticResource RoundedTextBoxStyle}" TextChanged="OnInputChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- 外边框设置 -->
                        <Border Background="#FAFAFA" BorderBrush="#EBEEF5" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkEnableBorder" VerticalAlignment="Center" Checked="OnBorderCheckChanged" Unchecked="OnBorderCheckChanged"/>
                                    <TextBlock Text="外边框宽度(px)" FontSize="13" Foreground="#606266" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                </StackPanel>

                                <TextBox x:Name="TxtBorderWidth" Grid.Column="1"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         IsEnabled="{Binding IsChecked, ElementName=ChkEnableBorder}"
                                         TextChanged="OnInputChanged"/>
                            </Grid>
                        </Border>

                        <!-- 结果展示 -->
                        <Border Background="#F0F7FF" BorderBrush="#D0E5FF" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="计算结果" FontSize="14" FontWeight="SemiBold" Foreground="#1D6ED8" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="总宽度 (targetWidth)" FontSize="12" Foreground="#6682A3"/>
                                        <TextBlock x:Name="LblTargetWidth" Text="--" FontSize="20" FontWeight="Bold" Foreground="#0F4BB8" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="总高度 (targetHeight)" FontSize="12" Foreground="#6682A3"/>
                                        <TextBlock x:Name="LblTargetHeight" Text="--" FontSize="20" FontWeight="Bold" Foreground="#0F4BB8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LblStatus" Text="" Foreground="#E6A23C" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 最下方靠左：作者与版本信息 -->
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/tpz9911"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               ToolTip="点击访问作者主页">
                        PZ v0.99.260922
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>